    - target: {fileID: 4547430730306592472, guid: 28350abf0c35d96438bdea918da976e5, type: 3}
      propertyPath: m_Name
      value: UI_Picture - Radios Normende
      objectReference: {fileID: 0}
    - target: {fileID: 5049050395348399052, guid: 28350abf0c35d96438bdea918da976e5, type: 3}
      propertyPath: text
      value: "Este hermoso radio fue fabricado en Alemania por Nordmende y tra\xEDdo
        a M\xE9xico bajo la marca <b>Elektra</b>, acercando a miles de familias mexicanas
        una tecnolog\xEDa que hasta entonces parec\xEDa lejana. Fue uno de los primeros
        modelos que ofreci\xF3 <b>FM</b>, adem\xE1s de la tradicional frecuencia
        de AM donde se pod\xEDan escuchar <b>radionovelas</b>, partidos de b\xE9isbol
        y las noticias que un\xEDan al pa\xEDs. Fue s\xEDmbolo de estatus y modernidad,
        un mueble que ocupaba un lugar de honor en la sala de los hogares mexicanos."
      objectReference: {fileID: 0}
    - target: {fileID: 5049050395348399052, guid: 28350abf0c35d96438bdea918da976e5, type: 3}
      propertyPath: year
